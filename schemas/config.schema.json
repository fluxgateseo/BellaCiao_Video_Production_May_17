{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bellaciao/schemas/config.schema.json",
  "title": "Pipeline defaults config",
  "type": "object",
  "required": ["engine", "image", "video", "approvalGate", "frameConventions"],
  "properties": {
    "engine": { "type": "string", "const": "higgsfield-mcp" },
    "engineNote": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["tool", "keyframeModel", "identityLock"],
      "properties": {
        "tool": { "type": "string" },
        "keyframeModel": { "type": "string" },
        "aspect_ratio": { "type": "string" },
        "resolution": { "type": "string" },
        "count": { "type": "integer", "minimum": 1, "maximum": 4 },
        "identityLock": {
          "type": "object",
          "required": ["mechanism"],
          "properties": {
            "mechanism": { "type": "string" }
          }
        }
      }
    },
    "video": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "klingToHiggsfieldMapping": { "type": "object" },
    "approvalGate": {
      "type": "object",
      "required": ["enabled", "type"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "type": { "type": "string", "const": "storyboard-level" }
      }
    },
    "frameConventions": {
      "type": "object",
      "required": ["resolution", "aspectRatio"],
      "properties": {
        "resolution": { "type": "string", "const": "1080x1920" },
        "aspectRatio": { "type": "string", "const": "9:16" }
      }
    }
  }
}
