{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bellaciao/schemas/manifest.schema.json",
  "title": "Manifest",
  "description": "Maps every Google Drive binary file ID to the commit that produced it. GitHub is the source of truth for text; Drive holds binaries; binaries are never committed.",
  "type": "object",
  "required": ["project", "driveRoot", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string", "const": "BellaCiao_Video_Production_May_17" },
    "driveRoot": { "type": "string", "minLength": 10, "description": "Drive folder ID of the project root" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["driveFileId", "kind", "producingCommit"],
        "additionalProperties": false,
        "properties": {
          "driveFileId": { "type": "string", "minLength": 10 },
          "kind": { "type": "string", "enum": ["start_frame", "end_frame", "reference", "render", "audio", "other"] },
          "contentItemId": { "type": "string" },
          "producingCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "createdAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
